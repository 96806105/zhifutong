# ===== 智服通 - 环境变量模板 =====
# 复制本文件为 .env 并填入真实值，切勿提交 .env

# GLM / 智谱大模型（OpenAI 兼容接口）
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-flash
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

# 可选：其他 OpenAI 兼容模型（多模型切换）
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Embedding（本地模型，需先运行 scripts/download_model.py 下载；运行时完全离线）
# 可用国内镜像：https://hf-mirror.com；模型：BAAI/bge-small-zh-v1.5
EMBEDDING_MODEL=./models/bge-small-zh-v1.5
HF_ENDPOINT=https://hf-mirror.com

# 系统配置
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET=change_this_secret_key
APP_DEBUG=true

# 知识库 / 向量库
KNOWLEDGE_BASE_DIR=knowledge_base
VECTOR_STORE_DIR=./data/chroma

# 数据库（对话历史，默认 SQLite）
DATABASE_URL=sqlite:///./data/support.db

# 转人工阈值
TRANSFER_FAIL_THRESHOLD=3

# 飞书真实人工接线（双向：人工在飞书回复 → 回写会话）
# ============================================================
# 启用前请先在飞书开放平台创建「企业自建应用」并开通机器人能力，
# 详见 docs/05-飞书人工接线.md。
# 1) 复制 .env.example 为 .env，将下面一行改为 LARK_ENABLED=true
# 2) 填入你的应用凭证与接收方（群聊 ID 或用户 open_id 二选一）
# ============================================================
LARK_ENABLED=false
LARK_APP_ID=
LARK_APP_SECRET=
# 推荐：把机器人拉进一个群，填群 chat_id
LARK_NOTIFY_CHAT_ID=
# 或：指定某个用户 open_id（机器人单聊给该用户）
LARK_NOTIFY_OPEN_ID=
# 人工客服联系电话（展示用，非必填）
LARK_CONTACT_PHONE=
