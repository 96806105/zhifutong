# ===== 智服通 - 环境变量模板 =====
# 复制本文件为 .env 并填入真实值，切勿提交 .env

# GLM / 智谱大模型（OpenAI 兼容接口）
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-flash
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

# 可选：其他 OpenAI 兼容模型（多模型切换）
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Embedding（本地模型，需先运行 scripts/download_model.py 下载；运行时完全离线）
# 可用国内镜像：https://hf-mirror.com；模型：BAAI/bge-small-zh-v1.5
EMBEDDING_MODEL=./models/bge-small-zh-v1.5
HF_ENDPOINT=https://hf-mirror.com

# 系统配置
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET=change_this_secret_key
APP_DEBUG=true

# 知识库 / 向量库
KNOWLEDGE_BASE_DIR=knowledge_base
VECTOR_STORE_DIR=./data/chroma

# 数据库（对话历史，默认 SQLite）
DATABASE_URL=sqlite:///./data/support.db

# 转人工阈值
TRANSFER_FAIL_THRESHOLD=3
